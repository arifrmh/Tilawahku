  "_meta": {
    "title": "Asmaul Husna (99 Nama Allah)",
    "source": "Urutan populer riwayat At-Tirmidzi (99 nama); uraian makna ringkas disusun orisinal oleh tim TILAWAHKU merujuk terjemahan Al-Qur'an dan literatur klasik Asmaul Husna.",
    "license": "GPL-3.0 (teks uraian aplikasi TILAWAHKU)",
    "updated_at": "2026-11-25"
  },
  "items": [
    {"number": 1, "arabic": "الرَّحْمَٰنُ", "transliteration": "Ar-Rahman", "meaning_id": "Yang Maha Pengasih", "description_id": "Kasih sayang Allah meliputi seluruh makhluk di dunia tanpa terkecuali.", "quran_refs": [{"surah": 1, "ayah": 3}, {"surah": 55, "ayah": 1}]},
    {"number": 2, "arabic": "الرَّحِيمُ", "transliteration": "Ar-Rahim", "meaning_id": "Yang Maha Penyayang", "description_id": "Kasih sayang khusus Allah yang dianugerahkan kepada hamba-hamba-Nya yang beriman di dunia dan akhirat.", "quran_refs": [{"surah": 1, "ayah": 3}, {"surah": 33, "ayah": 43}]},
    {"number": 3, "arabic": "الْمَلِكُ", "transliteration": "Al-Malik", "meaning_id": "Yang Maha Merajai", "description_id": "Penguasa mutlak atas seluruh alam semesta yang tidak bergantung pada siapa pun.", "quran_refs": [{"surah": 59, "ayah": 23}, {"surah": 20, "ayah": 114}]},
    {"number": 4, "arabic": "الْقُدُّوسُ", "transliteration": "Al-Quddus", "meaning_id": "Yang Maha Suci", "description_id": "Mahasuci dari segala kekurangan, cacat, dan penyerupaan dengan makhluk.", "quran_refs": [{"surah": 59, "ayah": 23}, {"surah": 62, "ayah": 1}]},
    {"number": 5, "arabic": "السَّلَامُ", "transliteration": "As-Salam", "meaning_id": "Yang Maha Memberi Kesejahteraan", "description_id": "Mahaselamat dari segala aib serta sumber keselamatan dan kedamaian bagi hamba-Nya.", "quran_refs": [{"surah": 59, "ayah": 23}]},
    {"number": 6, "arabic": "الْمُؤْمِنُ", "transliteration": "Al-Mu'min", "meaning_id": "Yang Maha Memberi Keamanan", "description_id": "Pemberi rasa aman, ketenangan, dan pembenar janji-Nya kepada para nabi serta orang beriman.", "quran_refs": [{"surah": 59, "ayah": 23}]},
    {"number": 7, "arabic": "الْمُهَيْمِنُ", "transliteration": "Al-Muhaimin", "meaning_id": "Yang Maha Memelihara", "description_id": "Pengawas dan penjaga segala sesuatu yang mengetahui setiap gerak-gerik makhluk.", "quran_refs": [{"surah": 59, "ayah": 23}]},
    {"number": 8, "arabic": "الْعَزِيزُ", "transliteration": "Al-Aziz", "meaning_id": "Yang Maha Perkasa", "description_id": "Mahaperkasa yang tidak terkalahkan dan segala kemuliaan berasal dari-Nya.", "quran_refs": [{"surah": 59, "ayah": 23}, {"surah": 3, "ayah": 6}]},
    {"number": 9, "arabic": "الْجَبَّارُ", "transliteration": "Al-Jabbar", "meaning_id": "Yang Memiliki Mutlak Kegagahan", "description_id": "Mahakuasa memaksakan kehendak-Nya serta memperbaiki dan menguatkan hati yang lemah.", "quran_refs": [{"surah": 59, "ayah": 23}]},
    {"number": 10, "arabic": "الْمُتَكَبِّرُ", "transliteration": "Al-Mutakabbir", "meaning_id": "Yang Maha Megah", "description_id": "Pemilik segala kebesaran dan keagungan yang hanya layak disandang oleh Allah.", "quran_refs": [{"surah": 59, "ayah": 23}]},
    {"number": 11, "arabic": "الْخَالِقُ", "transliteration": "Al-Khaliq", "meaning_id": "Yang Maha Pencipta", "description_id": "Pencipta seluruh alam dari ketiadaan dengan ukuran dan ketetapan yang sempurna.", "quran_refs": [{"surah": 59, "ayah": 24}, {"surah": 13, "ayah": 16}]},
    {"number": 12, "arabic": "الْبَارِئُ", "transliteration": "Al-Bari'", "meaning_id": "Yang Maha Melepaskan (Membentuk dari Ketiadaan)", "description_id": "Yang mengadakan makhluk hidup dengan bentuk dan keseimbangan tanpa contoh sebelumnya.", "quran_refs": [{"surah": 59, "ayah": 24}]},
    {"number": 13, "arabic": "الْمُصَوِّرُ", "transliteration": "Al-Musawwir", "meaning_id": "Yang Maha Membentuk Rupa", "description_id": "Yang membentuk rupa setiap makhluk sesuai hikmah dan kehendak-Nya.", "quran_refs": [{"surah": 59, "ayah": 24}, {"surah": 3, "ayah": 6}]},
    {"number": 14, "arabic": "الْغَفَّارُ", "transliteration": "Al-Ghaffar", "meaning_id": "Yang Maha Pengampun", "description_id": "Yang senantiasa menutupi aib dan mengampuni dosa hamba yang bertaubat berulang kali.", "quran_refs": [{"surah": 20, "ayah": 82}, {"surah": 71, "ayah": 10}]},
    {"number": 15, "arabic": "الْقَهَّارُ", "transliteration": "Al-Qahhar", "meaning_id": "Yang Maha Menundukkan", "description_id": "Yang menundukkan seluruh makhluk di bawah kekuasaan dan ketetapan-Nya.", "quran_refs": [{"surah": 13, "ayah": 16}, {"surah": 38, "ayah": 65}]},
    {"number": 16, "arabic": "الْوَهَّابُ", "transliteration": "Al-Wahhab", "meaning_id": "Yang Maha Pemberi Karunia", "description_id": "Pemberi segala nikmat dan anugerah secara cuma-cuma tanpa mengharapkan balasan.", "quran_refs": [{"surah": 3, "ayah": 8}, {"surah": 38, "ayah": 9}]},
    {"number": 17, "arabic": "الرَّزَّاقُ", "transliteration": "Ar-Razzaq", "meaning_id": "Yang Maha Pemberi Rezeki", "description_id": "Penjamin rezeki lahir dan batin bagi seluruh makhluk yang hidup di bumi.", "quran_refs": [{"surah": 51, "ayah": 58}]},
    {"number": 18, "arabic": "الْفَتَّاحُ", "transliteration": "Al-Fattah", "meaning_id": "Yang Maha Pembuka Rahmat", "description_id": "Pembuka pintu rahmat, ilmu, rezeki, dan keputusan yang adil bagi hamba-Nya.", "quran_refs": [{"surah": 34, "ayah": 26}]},
    {"number": 19, "arabic": "الْعَلِيمُ", "transliteration": "Al-Alim", "meaning_id": "Yang Maha Mengetahui", "description_id": "Ilmu-Nya meliputi segala yang tampak maupun tersembunyi, yang telah lalu dan yang akan datang.", "quran_refs": [{"surah": 2, "ayah": 29}, {"surah": 6, "ayah": 59}]},
    {"number": 20, "arabic": "الْقَابِضُ", "transliteration": "Al-Qabid", "meaning_id": "Yang Maha Menyempitkan", "description_id": "Yang menahan atau menyempitkan rezeki dan keadaan sesuai hikmah dan keadilan-Nya.", "quran_refs": [{"surah": 2, "ayah": 245}]},
    {"number": 21, "arabic": "الْبَاسِطُ", "transliteration": "Al-Basit", "meaning_id": "Yang Maha Melapangkan", "description_id": "Yang melapangkan rezeki, rahmat, dan hati bagi siapa yang Dia kehendaki.", "quran_refs": [{"surah": 2, "ayah": 245}, {"surah": 13, "ayah": 26}]},
    {"number": 22, "arabic": "الْخَافِضُ", "transliteration": "Al-Khafid", "meaning_id": "Yang Maha Merendahkan", "description_id": "Yang merendahkan derajat orang yang sombong dan durhaka dengan keadilan-Nya.", "quran_refs": [{"surah": 56, "ayah": 3}]},
    {"number": 23, "arabic": "الرَّافِعُ", "transliteration": "Ar-Rafi'", "meaning_id": "Yang Maha Meninggikan", "description_id": "Yang mengangkat derajat hamba-hamba yang beriman, bertakwa, dan berilmu.", "quran_refs": [{"surah": 58, "ayah": 11}, {"surah": 6, "ayah": 83}]},
    {"number": 24, "arabic": "الْمُعِزُّ", "transliteration": "Al-Mu'izz", "meaning_id": "Yang Maha Memuliakan", "description_id": "Yang menganugerahkan kemuliaan dan kehormatan kepada siapa yang dikehendaki-Nya.", "quran_refs": [{"surah": 3, "ayah": 26}]},
    {"number": 25, "arabic": "الْمُذِلُّ", "transliteration": "Al-Mudzill", "meaning_id": "Yang Maha Menghinakan", "description_id": "Yang mencabut kemuliaan dari siapa yang menentang kebenaran sesuai kehendak-Nya.", "quran_refs": [{"surah": 3, "ayah": 26}]},
    {"number": 26, "arabic": "السَّمِيعُ", "transliteration": "As-Sami'", "meaning_id": "Yang Maha Mendengar", "description_id": "Pendengaran-Nya mencakup setiap suara, doa, dan bisikan tanpa terhalang jarak.", "quran_refs": [{"surah": 2, "ayah": 127}, {"surah": 42, "ayah": 11}]},
    {"number": 27, "arabic": "الْبَصِيرُ", "transliteration": "Al-Basir", "meaning_id": "Yang Maha Melihat", "description_id": "Penglihatan-Nya meliputi segala yang kecil maupun besar, terang maupun tersembunyi.", "quran_refs": [{"surah": 42, "ayah": 11}, {"surah": 17, "ayah": 1}]},
    {"number": 28, "arabic": "الْحَكَمُ", "transliteration": "Al-Hakam", "meaning_id": "Yang Maha Menetapkan Hukum", "description_id": "Hakim yang paling adil yang keputusan-Nya tidak dapat ditolak atau dicurangi.", "quran_refs": [{"surah": 6, "ayah": 114}]},
    {"number": 29, "arabic": "الْعَدْلُ", "transliteration": "Al-Adl", "meaning_id": "Yang Maha Adil", "description_id": "Mahasempurna keadilan-Nya dan tidak pernah menzalimi hamba-Nya sedikit pun.", "quran_refs": [{"surah": 6, "ayah": 115}, {"surah": 4, "ayah": 40}]},
    {"number": 30, "arabic": "اللَّطِيفُ", "transliteration": "Al-Latif", "meaning_id": "Yang Maha Lembut", "description_id": "Mengetahui perkara yang sangat halus dan menyampaikan kebaikan kepada hamba dengan cara yang lembut.", "quran_refs": [{"surah": 6, "ayah": 103}, {"surah": 42, "ayah": 19}]},
    {"number": 31, "arabic": "الْخَبِيرُ", "transliteration": "Al-Khabir", "meaning_id": "Yang Maha Mengenal", "description_id": "Mengetahui hakikat terdalam segala sesuatu hingga rincian yang tidak tampak mata.", "quran_refs": [{"surah": 6, "ayah": 18}, {"surah": 67, "ayah": 14}]},
    {"number": 32, "arabic": "الْحَلِيمُ", "transliteration": "Al-Halim", "meaning_id": "Yang Maha Penyantun", "description_id": "Tidak tergesa-gesa menghukum hamba yang berbuat salah, melainkan memberi kesempatan bertaubat.", "quran_refs": [{"surah": 2, "ayah": 225}, {"surah": 17, "ayah": 44}]},
    {"number": 33, "arabic": "الْعَظِيمُ", "transliteration": "Al-Azim", "meaning_id": "Yang Maha Agung", "description_id": "Keagungan-Nya melampaui batas akal dan segala kebesaran di langit maupun bumi.", "quran_refs": [{"surah": 2, "ayah": 255}, {"surah": 42, "ayah": 4}]},
    {"number": 34, "arabic": "الْغَفُورُ", "transliteration": "Al-Ghafur", "meaning_id": "Yang Maha Pengampun", "description_id": "Luas ampunan-Nya terhadap dosa hamba yang memohon ampun dengan sungguh-sungguh.", "quran_refs": [{"surah": 39, "ayah": 53}, {"surah": 2, "ayah": 173}]},
    {"number": 35, "arabic": "الشَّكُورُ", "transliteration": "Asy-Syakur", "meaning_id": "Yang Maha Pembalas Budi (Menghargai)", "description_id": "Membalas amal kebaikan yang sedikit dengan pahala yang berlipat ganda.", "quran_refs": [{"surah": 35, "ayah": 30}, {"surah": 64, "ayah": 17}]},
    {"number": 36, "arabic": "الْعَلِيُّ", "transliteration": "Al-Aliyy", "meaning_id": "Yang Maha Tinggi", "description_id": "Mahatinggi kedudukan, kemuliaan, dan kekuasaan-Nya di atas segala sesuatu.", "quran_refs": [{"surah": 2, "ayah": 255}, {"surah": 42, "ayah": 4}]},
    {"number": 37, "arabic": "الْكَبِيرُ", "transliteration": "Al-Kabir", "meaning_id": "Yang Maha Besar", "description_id": "Mahabesar dzat dan sifat-Nya sehingga segala selain-Nya kecil di hadapan-Nya.", "quran_refs": [{"surah": 13, "ayah": 9}, {"surah": 22, "ayah": 62}]},
    {"number": 38, "arabic": "الْحَفِيظُ", "transliteration": "Al-Hafiz", "meaning_id": "Yang Maha Memelihara", "description_id": "Penjaga langit, bumi, amal hamba, dan seluruh ciptaan agar tetap terpelihara.", "quran_refs": [{"surah": 11, "ayah": 57}, {"surah": 34, "ayah": 21}]},
    {"number": 39, "arabic": "الْمُقِيتُ", "transliteration": "Al-Muqit", "meaning_id": "Yang Maha Pemberi Kecukupan", "description_id": "Pemberi makanan, kekuatan, dan kecukupan yang menjaga kelangsungan hidup makhluk.", "quran_refs": [{"surah": 4, "ayah": 85}]},
    {"number": 40, "arabic": "الْحَسِيبُ", "transliteration": "Al-Hasib", "meaning_id": "Yang Maha Membuat Perhitungan", "description_id": "Mencukupi kebutuhan hamba yang bertawakal serta teliti menghitung seluruh amal perbuatan.", "quran_refs": [{"surah": 4, "ayah": 6}, {"surah": 33, "ayah": 39}]},
    {"number": 41, "arabic": "الْجَلِيلُ", "transliteration": "Al-Jalil", "meaning_id": "Yang Maha Luhur", "description_id": "Pemilik segala sifat keagungan, kemuliaan, dan kesempurnaan.", "quran_refs": [{"surah": 55, "ayah": 27}]},
    {"number": 42, "arabic": "الْكَرِيمُ", "transliteration": "Al-Karim", "meaning_id": "Yang Maha Pemurah", "description_id": "Mahadermawan yang memberi sebelum diminta dan melimpahkan kebaikan tiada henti.", "quran_refs": [{"surah": 82, "ayah": 6}, {"surah": 27, "ayah": 40}]},
    {"number": 43, "arabic": "الرَّقِيبُ", "transliteration": "Ar-Raqib", "meaning_id": "Yang Maha Mengawasi", "description_id": "Selalu mengawasi setiap ucapan, perbuatan, dan niat di dalam dada manusia.", "quran_refs": [{"surah": 4, "ayah": 1}, {"surah": 33, "ayah": 52}]},
    {"number": 44, "arabic": "الْمُجِيبُ", "transliteration": "Al-Mujib", "meaning_id": "Yang Maha Mengabulkan", "description_id": "Maha dekat dan mengabulkan doa serta permohonan hamba yang berseru kepada-Nya.", "quran_refs": [{"surah": 11, "ayah": 61}, {"surah": 2, "ayah": 186}]},
    {"number": 45, "arabic": "الْوَاسِعُ", "transliteration": "Al-Wasi'", "meaning_id": "Yang Maha Luas", "description_id": "Rahmat, ilmu, kekayaan, dan ampunan-Nya sangat luas tiada bertepi.", "quran_refs": [{"surah": 2, "ayah": 115}, {"surah": 2, "ayah": 268}]},
    {"number": 46, "arabic": "الْحَكِيمُ", "transliteration": "Al-Hakim", "meaning_id": "Yang Maha Bijaksana", "description_id": "Setiap penciptaan, syariat, dan ketetapan-Nya selalu dilandasi hikmah yang sempurna.", "quran_refs": [{"surah": 2, "ayah": 32}, {"surah": 31, "ayah": 27}]},
    {"number": 47, "arabic": "الْوَدُودُ", "transliteration": "Al-Wadud", "meaning_id": "Yang Maha Mengasihi (Mencintai)", "description_id": "Mencintai hamba-hamba-Nya yang saleh dan dicintai oleh hati orang-orang beriman.", "quran_refs": [{"surah": 11, "ayah": 90}, {"surah": 85, "ayah": 14}]},
    {"number": 48, "arabic": "الْمَجِيدُ", "transliteration": "Al-Majid", "meaning_id": "Yang Maha Mulia", "description_id": "Mahamulia dzat dan perbuatan-Nya dengan kelapangan kebaikan yang sempurna.", "quran_refs": [{"surah": 11, "ayah": 73}, {"surah": 85, "ayah": 15}]},
    {"number": 49, "arabic": "الْبَاعِثُ", "transliteration": "Al-Ba'its", "meaning_id": "Yang Maha Membangkitkan", "description_id": "Membangkitkan manusia dari kubur pada hari kiamat serta mengutus para rasul.", "quran_refs": [{"surah": 22, "ayah": 7}]},
    {"number": 50, "arabic": "الشَّهِيدُ", "transliteration": "Asy-Syahid", "meaning_id": "Yang Maha Menyaksikan", "description_id": "Menyaksikan segala kejadian di alam semesta tanpa satu pun yang luput.", "quran_refs": [{"surah": 4, "ayah": 79}, {"surah": 85, "ayah": 9}]},
    {"number": 51, "arabic": "الْحَقُّ", "transliteration": "Al-Haqq", "meaning_id": "Yang Maha Benar", "description_id": "Wujud-Nya pasti dan nyata; firman, janji, serta pertemuan dengan-Nya adalah kebenaran mutlak.", "quran_refs": [{"surah": 22, "ayah": 6}, {"surah": 20, "ayah": 114}]},
    {"number": 52, "arabic": "الْوَكِيلُ", "transliteration": "Al-Wakil", "meaning_id": "Yang Maha Memelihara (Mewakili)", "description_id": "Sebaik-baik tempat berserah diri dan pengatur segala urusan makhluk.", "quran_refs": [{"surah": 3, "ayah": 173}, {"surah": 73, "ayah": 9}]},
    {"number": 53, "arabic": "الْقَوِيُّ", "transliteration": "Al-Qawiyy", "meaning_id": "Yang Maha Kuat", "description_id": "Memiliki kekuatan yang sempurna dan tidak pernah lemah atau lelah.", "quran_refs": [{"surah": 11, "ayah": 66}, {"surah": 42, "ayah": 19}]},
    {"number": 54, "arabic": "الْمَتِينُ", "transliteration": "Al-Matin", "meaning_id": "Yang Maha Kokoh", "description_id": "Sangat teguh kekuatan dan kekuasaan-Nya tanpa sedikit pun goyah.", "quran_refs": [{"surah": 51, "ayah": 58}]},
    {"number": 55, "arabic": "الْوَلِيُّ", "transliteration": "Al-Waliyy", "meaning_id": "Yang Maha Melindungi", "description_id": "Pelindung dan penolong sejati bagi orang-orang yang beriman dan bertakwa.", "quran_refs": [{"surah": 2, "ayah": 257}, {"surah": 42, "ayah": 28}]},
    {"number": 56, "arabic": "الْحَمِيدُ", "transliteration": "Al-Hamid", "meaning_id": "Yang Maha Terpuji", "description_id": "Berhak atas segala pujian dalam setiap keadaan karena kesempurnaan sifat dan nikmat-Nya.", "quran_refs": [{"surah": 14, "ayah": 1}, {"surah": 31, "ayah": 26}]},
    {"number": 57, "arabic": "الْمُحْصِي", "transliteration": "Al-Muhsi", "meaning_id": "Yang Maha Menghitung", "description_id": "Mengetahui jumlah dan hitungan segala sesuatu di alam semesta dengan tepat.", "quran_refs": [{"surah": 72, "ayah": 28}, {"surah": 19, "ayah": 94}]},
    {"number": 58, "arabic": "الْمُبْدِئُ", "transliteration": "Al-Mubdi'", "meaning_id": "Yang Maha Memulai", "description_id": "Memulai penciptaan segala makhluk pertama kali dari ketiadaan.", "quran_refs": [{"surah": 10, "ayah": 4}, {"surah": 85, "ayah": 13}]},
    {"number": 59, "arabic": "الْمُعِيدُ", "transliteration": "Al-Mu'id", "meaning_id": "Yang Maha Mengembalikan Kehidupan", "description_id": "Mengembalikan makhluk hidup kembali setelah mati pada hari kebangkitan.", "quran_refs": [{"surah": 10, "ayah": 4}, {"surah": 85, "ayah": 13}]},
    {"number": 60, "arabic": "الْمُحْيِي", "transliteration": "Al-Muhyi", "meaning_id": "Yang Maha Menghidupkan", "description_id": "Pemberi kehidupan bagi setiap makhluk dan menghidupkan kembali bumi yang tandus.", "quran_refs": [{"surah": 30, "ayah": 50}, {"surah": 41, "ayah": 39}]},
    {"number": 61, "arabic": "الْمُمِيتُ", "transliteration": "Al-Mumit", "meaning_id": "Yang Maha Mematikan", "description_id": "Penentu ajal setiap makhluk yang bernyawa sesuai waktu yang telah ditetapkan.", "quran_refs": [{"surah": 3, "ayah": 156}, {"surah": 15, "ayah": 23}]},
    {"number": 62, "arabic": "الْحَيُّ", "transliteration": "Al-Hayy", "meaning_id": "Yang Maha Hidup", "description_id": "Hidup kekal abadi dengan kehidupan yang sempurna, tanpa awal dan tanpa akhir.", "quran_refs": [{"surah": 2, "ayah": 255}, {"surah": 25, "ayah": 58}]},
    {"number": 63, "arabic": "الْقَيُّومُ", "transliteration": "Al-Qayyum", "meaning_id": "Yang Maha Mandiri", "description_id": "Berdiri sendiri tanpa membutuhkan siapa pun serta terus-menerus mengurus seluruh makhluk.", "quran_refs": [{"surah": 2, "ayah": 255}, {"surah": 3, "ayah": 2}]},
    {"number": 64, "arabic": "الْوَاجِدُ", "transliteration": "Al-Wajid", "meaning_id": "Yang Maha Penemu (Maha Kaya)", "description_id": "Memiliki segala sesuatu yang dikehendaki-Nya dan tidak pernah kekurangan apa pun.", "quran_refs": [{"surah": 38, "ayah": 44}]},
    {"number": 65, "arabic": "الْمَاجِدُ", "transliteration": "Al-Majid", "meaning_id": "Yang Maha Mulia dan Agung", "description_id": "Memiliki kemuliaan tinggi dan kedermawanan yang tak terbatas.", "quran_refs": [{"surah": 85, "ayah": 15}]},
    {"number": 66, "arabic": "الْوَاحِدُ", "transliteration": "Al-Wahid", "meaning_id": "Yang Maha Tunggal", "description_id": "Esa dalam dzat, sifat, dan perbuatan-Nya; tidak ada sekutu bagi-Nya.", "quran_refs": [{"surah": 2, "ayah": 163}, {"surah": 13, "ayah": 16}]},
    {"number": 67, "arabic": "الْأَحَدُ", "transliteration": "Al-Ahad", "meaning_id": "Yang Maha Esa", "description_id": "Satu-satunya Tuhan yang tiada tandingan, tiada beranak, dan tiada diperanakkan.", "quran_refs": [{"surah": 112, "ayah": 1}]},
    {"number": 68, "arabic": "الصَّمَدُ", "transliteration": "As-Samad", "meaning_id": "Yang Maha Dibutuhkan", "description_id": "Tempat bergantung segala makhluk sementara Dia tidak bergantung pada siapa pun.", "quran_refs": [{"surah": 112, "ayah": 2}]},
    {"number": 69, "arabic": "الْقَادِرُ", "transliteration": "Al-Qadir", "meaning_id": "Yang Maha Menentukan (Berkuasa)", "description_id": "Mahakuasa melakukan segala sesuatu yang dikehendaki tanpa hambatan.", "quran_refs": [{"surah": 6, "ayah": 65}, {"surah": 36, "ayah": 81}]},
    {"number": 70, "arabic": "الْمُقْتَدِرُ", "transliteration": "Al-Muqtadir", "meaning_id": "Yang Maha Berkuasa", "description_id": "Pemilik kekuasaan penuh dan sempurna atas seluruh ciptaan dan ketetapan-Nya.", "quran_refs": [{"surah": 18, "ayah": 45}, {"surah": 54, "ayah": 42}]},
    {"number": 71, "arabic": "الْمُقَدِّمُ", "transliteration": "Al-Muqaddim", "meaning_id": "Yang Maha Mendahulukan", "description_id": "Mendahulukan apa atau siapa yang dikehendaki-Nya sesuai hikmah yang sempurna.", "quran_refs": [{"surah": 50, "ayah": 28}]},
    {"number": 72, "arabic": "الْمُؤَخِّرُ", "transliteration": "Al-Mu'akhkhir", "meaning_id": "Yang Maha Mengakhirkan", "description_id": "Menunda atau mengakhirkan sesuatu hingga waktu yang paling tepat menurut ilmu-Nya.", "quran_refs": [{"surah": 14, "ayah": 42}, {"surah": 71, "ayah": 4}]},
    {"number": 73, "arabic": "الْأَوَّلُ", "transliteration": "Al-Awwal", "meaning_id": "Yang Maha Awal", "description_id": "Ada sebelum segala sesuatu ada, tanpa permulaan.", "quran_refs": [{"surah": 57, "ayah": 3}]},
    {"number": 74, "arabic": "الْآخِرُ", "transliteration": "Al-Akhir", "meaning_id": "Yang Maha Akhir", "description_id": "Tetap kekal setelah segala sesuatu fana, tanpa berakhir.", "quran_refs": [{"surah": 57, "ayah": 3}]},
    {"number": 75, "arabic": "الظَّاهِرُ", "transliteration": "Az-Zahir", "meaning_id": "Yang Maha Nyata", "description_id": "Mahatinggi di atas segala sesuatu dan tanda-tanda keberadaan-Nya nyata di seluruh alam.", "quran_refs": [{"surah": 57, "ayah": 3}]},
    {"number": 76, "arabic": "الْبَاطِنُ", "transliteration": "Al-Batin", "meaning_id": "Yang Maha Ghaib (Tersembunyi)", "description_id": "Maha dekat dan mengetahui hal-hal batin sementara dzat-Nya tidak terjangkau pandangan dunia.", "quran_refs": [{"surah": 57, "ayah": 3}]},
    {"number": 77, "arabic": "الْوَالِي", "transliteration": "Al-Wali", "meaning_id": "Yang Maha Memerintah", "description_id": "Pengatur dan pemegang kendali penuh atas seluruh urusan alam semesta.", "quran_refs": [{"surah": 13, "ayah": 11}]},
    {"number": 78, "arabic": "الْمُتَعَالِي", "transliteration": "Al-Muta'ali", "meaning_id": "Yang Maha Tinggi", "description_id": "Mahatinggi dan tersucikan dari segala sifat kekurangan makhluk.", "quran_refs": [{"surah": 13, "ayah": 9}]},
    {"number": 79, "arabic": "الْبَرُّ", "transliteration": "Al-Barr", "meaning_id": "Yang Maha Penderma (Sumber Kebajikan)", "description_id": "Melimpahkan kebaikan, kelembutan, dan anugerah yang luas kepada para hamba-Nya.", "quran_refs": [{"surah": 52, "ayah": 28}]},
    {"number": 80, "arabic": "التَّوَّابُ", "transliteration": "At-Tawwab", "meaning_id": "Yang Maha Penerima Taubat", "description_id": "Senantiasa membimbing hamba untuk bertaubat dan menerima taubat yang tulus.", "quran_refs": [{"surah": 2, "ayah": 37}, {"surah": 49, "ayah": 12}]},
    {"number": 81, "arabic": "الْمُنْتَقِمُ", "transliteration": "Al-Muntaqim", "meaning_id": "Yang Maha Pemberi Balasan", "description_id": "Memberi balasan setimpal dengan adil kepada orang-orang yang terus berbuat zalim.", "quran_refs": [{"surah": 32, "ayah": 22}]},
    {"number": 82, "arabic": "الْعَفُوُّ", "transliteration": "Al-Afuww", "meaning_id": "Yang Maha Pemaaf", "description_id": "Menghapus kesalahan dan dosa hamba hingga seolah tidak pernah tercatat.", "quran_refs": [{"surah": 4, "ayah": 149}, {"surah": 22, "ayah": 60}]},
    {"number": 83, "arabic": "الرَّءُوفُ", "transliteration": "Ar-Ra'uf", "meaning_id": "Yang Maha Pengasuh (Belas Kasih)", "description_id": "Memiliki belas kasih yang sangat dalam kepada hamba-hamba-Nya.", "quran_refs": [{"surah": 2, "ayah": 143}, {"surah": 59, "ayah": 10}]},
    {"number": 84, "arabic": "مَالِكُ الْمُلْكِ", "transliteration": "Malikul-Mulk", "meaning_id": "Yang Maha Penguasa Kerajaan", "description_id": "Pemilik mutlak seluruh kerajaan yang memberi dan mencabut kekuasaan sekehendak-Nya.", "quran_refs": [{"surah": 3, "ayah": 26}]},
    {"number": 85, "arabic": "ذُو الْجَلَالِ وَالْإِكْرَامِ", "transliteration": "Dzul-Jalali wal-Ikram", "meaning_id": "Yang Maha Pemilik Kebesaran dan Kemuliaan", "description_id": "Pemilik keagungan yang layak diagungkan serta kemuliaan yang melimpahkan kebaikan.", "quran_refs": [{"surah": 55, "ayah": 27}, {"surah": 55, "ayah": 78}]},
    {"number": 86, "arabic": "الْمُقْسِطُ", "transliteration": "Al-Muqsit", "meaning_id": "Yang Maha Pemberi Keadilan", "description_id": "Menegakkan keadilan secara sempurna dan membela orang-orang yang terzalimi.", "quran_refs": [{"surah": 3, "ayah": 18}, {"surah": 21, "ayah": 47}]},
    {"number": 87, "arabic": "الْجَامِعُ", "transliteration": "Al-Jami'", "meaning_id": "Yang Maha Mengumpulkan", "description_id": "Mengumpulkan seluruh manusia pada hari kiamat serta menghimpun segala kesempurnaan sifat.", "quran_refs": [{"surah": 3, "ayah": 9}]},
    {"number": 88, "arabic": "الْغَنِيُّ", "transliteration": "Al-Ghaniyy", "meaning_id": "Yang Maha Kaya", "description_id": "Mahakaya dan sama sekali tidak membutuhkan ibadah maupun bantuan makhluk.", "quran_refs": [{"surah": 35, "ayah": 15}, {"surah": 47, "ayah": 38}]},
    {"number": 89, "arabic": "الْمُغْنِي", "transliteration": "Al-Mughni", "meaning_id": "Yang Maha Pemberi Kekayaan", "description_id": "Mencukupkan dan menganugerahkan kekayaan lahir serta ketenangan hati kepada hamba-Nya.", "quran_refs": [{"surah": 9, "ayah": 28}, {"surah": 53, "ayah": 48}]},
    {"number": 90, "arabic": "الْمَانِعُ", "transliteration": "Al-Mani'", "meaning_id": "Yang Maha Mencegah", "description_id": "Menahan mudarat dari hamba-Nya atau menahan sesuatu demi kebaikan yang lebih besar.", "quran_refs": [{"surah": 67, "ayah": 21}]},
    {"number": 91, "arabic": "الضَّارُّ", "transliteration": "Ad-Darr", "meaning_id": "Yang Maha Penimpa Kemudaratan", "description_id": "Tidak ada ujian atau bahaya yang menimpa makhluk kecuali atas izin dan hikmah-Nya.", "quran_refs": [{"surah": 6, "ayah": 17}, {"surah": 10, "ayah": 107}]},
    {"number": 92, "arabic": "النَّافِعُ", "transliteration": "An-Nafi'", "meaning_id": "Yang Maha Memberi Manfaat", "description_id": "Sumber segala kebaikan dan manfaat bagi kehidupan di dunia maupun akhirat.", "quran_refs": [{"surah": 10, "ayah": 107}, {"surah": 35, "ayah": 2}]},
    {"number": 93, "arabic": "النُّورُ", "transliteration": "An-Nur", "meaning_id": "Yang Maha Bercahaya", "description_id": "Pemberi cahaya petunjuk bagi langit, bumi, dan hati orang-orang beriman.", "quran_refs": [{"surah": 24, "ayah": 35}]},
    {"number": 94, "arabic": "الْهَادِي", "transliteration": "Al-Hadi", "meaning_id": "Yang Maha Pemberi Petunjuk", "description_id": "Membimbing setiap makhluk pada fitrahnya dan memberi hidayah ke jalan yang lurus.", "quran_refs": [{"surah": 25, "ayah": 31}, {"surah": 22, "ayah": 54}]},
    {"number": 95, "arabic": "الْبَدِيعُ", "transliteration": "Al-Badi'", "meaning_id": "Yang Maha Pencipta yang Tiada Bandingnya", "description_id": "Menciptakan langit dan bumi dengan keindahan luar biasa tanpa contoh sebelumnya.", "quran_refs": [{"surah": 2, "ayah": 117}, {"surah": 6, "ayah": 101}]},
    {"number": 96, "arabic": "الْبَاقِي", "transliteration": "Al-Baqi", "meaning_id": "Yang Maha Kekal", "description_id": "Kekal abadi selamanya sedangkan seluruh makhluk akan binasa.", "quran_refs": [{"surah": 55, "ayah": 27}, {"surah": 20, "ayah": 73}]},
    {"number": 97, "arabic": "الْوَارِثُ", "transliteration": "Al-Warits", "meaning_id": "Yang Maha Pewaris", "description_id": "Tetap ada dan memiliki segala sesuatu setelah seluruh pemilik fana tiada.", "quran_refs": [{"surah": 15, "ayah": 23}, {"surah": 19, "ayah": 40}]},
    {"number": 98, "arabic": "الرَّشِيدُ", "transliteration": "Ar-Rasyid", "meaning_id": "Yang Maha Pandai (Membimbing Tepat)", "description_id": "Segala urusan dan bimbingan-Nya tepat, terarah, dan membawa kepada kebaikan.", "quran_refs": [{"surah": 11, "ayah": 87}]},
    {"number": 99, "arabic": "الصَّبُورُ", "transliteration": "As-Sabur", "meaning_id": "Yang Maha Sabar", "description_id": "Tidak tergesa-gesa menjatuhkan azab dan selalu mengatur segala sesuatu pada waktunya.", "quran_refs": [{"surah": 16, "ayah": 61}]}
  ]
}
